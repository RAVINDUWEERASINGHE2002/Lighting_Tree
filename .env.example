# ==============================================================================
# LIGHTING TREE POS - CLOUD DATABASE CONFIGURATION
# ==============================================================================

# OPTION 1: SUPABASE (RECOMMENDED - 100% FREE POSTGRESQL & REALTIME SYNC)
# 1. Create a free project on https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and Anon Public Key below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# OPTION 2: FIREBASE (ALTERNATIVE - SPARK FREE PLAN)
# VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=your-app-id
